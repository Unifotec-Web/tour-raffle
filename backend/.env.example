APP_ENV=development
APP_NAME=Tour Raffle API
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tour_raffle

SESSION_COOKIE_SECURE=false
SESSION_HOURS=8

FRONTEND_URL=http://localhost:3000

ENABLE_LOCAL_DRAW=false
# All payment providers are disabled until explicitly configured in local/test mode.
ENABLE_FAKE_PAYMENTS=false
FAKE_PAYMENT_SECRET=
ENABLE_STRIPE_SANDBOX=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ENABLE_PAYSTACK_SANDBOX=false
PAYSTACK_SECRET_KEY=
CHECKOUT_HOLD_MINUTES=30
